source "https://rubygems.org"

# Use the same Jekyll + plugin versions that GitHub Pages builds with.
# See: https://pages.github.com/versions/
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-seo-tag"
end

# Gems removed from Ruby's bundled set that Jekyll 3.9 still requires at runtime.
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
gem "webrick", "~> 1.8"
